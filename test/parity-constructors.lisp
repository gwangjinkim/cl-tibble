(in-package :cl-tibble/test)
(in-suite :cl-tibble)

(defclass tb1-extension (tbl) ())
(defmethod as-tibble ((x tb1-extension)) x)

(test tb1-public-hash-mutation-remains-visible
  (let* ((table (tibble :x #(1 2))) (replacement #(8 9)))
    (setf (gethash "x" (tbl-columns table)) replacement)
    (is (eq replacement (tbl-col table :x)))
    (is (eq replacement (tbl-col table 0)))
    (is (eq replacement (tbl-col (as-tibble table) 0)))))

(test tb1-row-size-and-missing-prototype
  (let* ((empty (tibble-row))
         (row (as-tibble-row (let ((x (cl-vctrs-lite:make-typed-column
                                      (vector cl-vctrs-lite:*na* 2) :int)))
                              (setf (cl-vctrs-lite:col-names x) #("a" "b")) x))))
    (is (= 1 (tbl-nrows empty)))
    (is (= 0 (length (tbl-names empty))))
    (is (eq :int (cl-vctrs-lite:col-type (tbl-col row :a))))
    (is (cl-vctrs-lite:na-p (tbl-ref row 0 :a)))
    (is (= 2 (tbl-ref row 0 :b)))
    (is (null (cl-vctrs-lite:col-names (tbl-col row :a)))))
  (signals tibble-error (as-tibble-row #(1 2)))
  (signals tibble-error (as-tibble-row nil))
  (signals tibble-error (tibble-row :x #(1 2)))
  (signals tibble-error (tibble-row :x #())))

(test tb1-explicit-column-and-row-counts
  (let* ((column (cl-vctrs-lite:make-typed-column #() :double))
         (table (as-tibble-col column :column-name "data"))
         (rows (tibble (constructor-options :rows 3)))
         (zero (tibble :x column :y nil)))
    (is (= 0 (tbl-nrows table)))
    (is (eq :double (cl-vctrs-lite:col-type (tbl-col table :data))))
    (is (= 3 (tbl-nrows rows)))
    (is (= 0 (length (tbl-names rows))))
    (is (= 0 (tbl-nrows zero)))
    (is (eq :bool (cl-vctrs-lite:col-type (tbl-col zero :y)))))
  (signals tibble-error (tibble (constructor-options :rows -1)))
  (signals tibble-error (tibble (constructor-options :rows 3) :x #(1 2)))
  (signals tibble-error (tibble :x #() :y #(1 2))))

(test tb1-minimal-duplicates-preserve-positional-data
  (let* ((table (tibble (constructor-options :name-repair :minimal) "x" #(1 2) "x" #(8 9)))
         (sub (slice table :rows '(1) :cols '(1 0))))
    (is (equalp #("x" "x") (tbl-names table)))
    (is (equalp #(1 2) (tbl-col table "x")))
    (is (equalp #(8 9) (tbl-col table 1)))
    (is (= 1 (tbl-nrows sub)))
    (is (equalp #("x" "x") (tbl-names sub)))
    (is (equalp #(9) (tbl-col sub 0)))
    (is (equalp #(2) (tbl-col sub 1)))
    (is (search "9" (with-output-to-string (stream) (print-object sub stream))))))

(test tb1-repair-and-legacy-scalar-list
  (let ((table (tibble (constructor-options :name-repair :unique) :x 1 :x 2))
        (legacy (tibble :x '(1 2))))
    (is (equalp #("x...1" "x...2") (tbl-names table)))
    (is (equalp #("..1x" "._x" ".if")
                (tbl-names (tibble (constructor-options :name-repair :universal) "1x" 1 "_x" 2 "if" 3))))
    (is (= 1 (tbl-nrows legacy)))
    (is (equal '(1 2) (tbl-ref legacy 0 :x)))))

(test tb1-low-level-validation-is-explicit
  (let ((table (new-tibble (list (cons "x" #(1 2 3))) :nrow 2))
        (empty (new-tibble nil :nrow 5))
        (null-col (new-tibble (list (cons "x" nil)))))
    (is (= 2 (tbl-nrows table)))
    (is (= 3 (cl-vctrs-lite:col-length (tbl-col table :x))))
    (signals tibble-error (validate-tibble table))
    (is (eq empty (validate-tibble empty)))
    (is (= 5 (tbl-nrows empty)))
    (is (= 0 (tbl-nrows null-col)))
    (is (null (tbl-col null-col :x)))
    (signals tibble-error (validate-tibble null-col)))
  (signals tibble-error (new-tibble #(1 2)))
  (signals tibble-error (validate-tibble (new-tibble (list (cons "x" #(1))) :nrow 3))))

(test tb1-sequential-lists-and-tibbles
  (let ((out (lst (:n 3) (:x (make-array n :initial-element 7))))
        (empty (lst))
        (table (tibble* (:x #(1 2 3)) (:y (map 'vector (lambda (v) (* v 2)) x)))))
    (is (= 3 (cdr (assoc "n" out :test #'equal))))
    (is (equalp #(7 7 7) (cdr (assoc "x" out :test #'equal))))
    (is (eq :list (cl-vctrs-lite:col-type empty)))
    (is (equalp #() (cl-vctrs-lite:col-names empty)))
    (is (equalp #(2 4 6) (tbl-col table :y)))
    (is (= 3 (tbl-nrows table))))
  (let ((x #(1 2))) (is (equalp #("x") (coerce (mapcar #'car (lst x)) 'vector)))))

(test tb1-matrix-coercion-and-list-column-types
  (multiple-value-bind (matrix names prototype) (frame-matrix :a :b 1 2 3 4)
    (let ((table (as-tibble matrix)))
      (is (equal '(2 2) (array-dimensions matrix)))
      (is (equalp #("a" "b") names))
      (is (eq :int prototype))
      (is (equalp #(1 3) (tbl-col table :a)))
      (is (equalp #(2 4) (tbl-col table :b)))))
  (let ((table (as-tibble-col (list #(1) #(2 3)))))
    (is (eq :list (cl-vctrs-lite:col-type (tbl-col table :value))))
    (is (= 2 (tbl-nrows table)))
    (is (equalp #(2 3) (tbl-ref table 1 :value))))
  (signals tibble-error (frame-matrix :a :b 1))
  (signals tibble-error (tibble :nested (tibble :x 1)))
  (signals tibble-error (tibble :nested #2A((1 2)))))

(test tb1-named-deframe-option-and-extension-generic
  (let* ((table (tibble :key #("a" "b") :value #(1 2)))
         (result (deframe table :named-vector t))
         (extension (new-tibble nil :class 'tb1-extension :nrow 4
                                   :attributes (list (cons "unit" "km")))))
    (is (equalp #(1 2) result))
    (is (eq :int (cl-vctrs-lite:col-type result)))
    (is (equalp #("a" "b") (cl-vctrs-lite:col-names result)))
    (is (equal '(("a" . 1) ("b" . 2)) (deframe table)))
    (is (is-tibble extension))
    (is (eq extension (as-tibble extension)))
    (is (equal "km" (tbl-attribute extension "unit")))
    (is (= 4 (tbl-nrows extension))))
  (is (not (is-tibble #(1 2)))))

(test tb1-legacy-flat-option-like-column-keys
  (let ((table (tibble :rows #(1 2) :name-repair #("a" "b")))
        (blank (tibble "" 1)))
    (is (equalp #("rows" "name-repair") (tbl-names table)))
    (is (equalp #(1 2) (tbl-col table :rows)))
    (is (equalp #("a" "b") (tbl-col table :name-repair)))
    (is (equalp #("") (tbl-names blank))))
  (signals tibble-error (tibble (constructor-options) "" 1)))
(test tb1-slice-preserves-unknown-column-condition
  (let ((table (tibble :x #(1 2))))
    (signals unknown-column-error (slice table :cols '("missing")))
    (signals unknown-column-error (slice table :cols '(:missing)))))
(test tb1-computed-null-is-omitted
  (let ((table (tibble :x #(1 2)
                       :drop (computed-column (lambda (prior)
                                                (declare (ignore prior))
                                                (cl-tibble::null-column))))))
    (is (equalp #("x") (tbl-names table)))
    (is (= 2 (tbl-nrows table)))))

(test tb1-matrix-scalar-owners-retain-missing-types
  (multiple-value-bind (matrix names prototype)
      (frame-matrix :x (cl-vctrs-lite:make-typed-column (vector cl-vctrs-lite:*na*) :int)
                       (cl-vctrs-lite:make-typed-column (vector cl-vctrs-lite:*na*) :int))
    (is (equal '(2 1) (array-dimensions matrix)))
    (is (equalp #("x") names))
    (is (eq :int prototype))
    (is (cl-vctrs-lite:na-p (aref matrix 0 0)))
    (is (eq :int (cl-vctrs-lite:col-type (tbl-col (as-tibble matrix) :x)))))
  (signals tibble-error (frame-matrix :x (cl-vctrs-lite:make-typed-column #(1) :list))))

(test tb1-scalar-false-and-explicit-null-are-distinct
  (let ((false (as-tibble-col nil))
        (null (as-tibble-col (cl-tibble::null-column)))
        (row (as-tibble-row nil :name-repair :unique)))
    (is (= 1 (tbl-nrows false)))
    (is (eq :bool (cl-vctrs-lite:col-type (tbl-col false :value))))
    (is (null (tbl-ref false 0 :value)))
    (is (= 0 (tbl-nrows null)))
    (is (= 0 (length (tbl-names null))))
    (is (= 1 (tbl-nrows row)))
    (is (equalp #("...1") (tbl-names row)))
    (is (null (tbl-ref row 0 0))))
  (signals tibble-error (as-tibble-row (cl-tibble::null-column))))

(test tb1-as-tibble-preserves-alist-proper-list-columns
  (let ((table (as-tibble '(("x" 1 2) ("y" 3 4)))))
    (is (= 2 (tbl-nrows table)))
    (is (equalp #(1 2) (tbl-col table :x)))
    (is (equalp #(3 4) (tbl-col table :y)))
    (is (eq :int (cl-vctrs-lite:col-type (tbl-col table :x)))))
  (let ((table (as-tibble '(:x (1 2)))))
    (is (= 1 (tbl-nrows table)))
    (is (equal '(1 2) (tbl-ref table 0 :x)))))
